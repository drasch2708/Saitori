# OPTIONAL — the temple runs fully without any key.
#
# ANTHROPIC_API_KEY enables two things (get one at https://console.anthropic.com/):
#   1. The listening temple: reflections released during `breathe` are answered
#      with living koans instead of drawn from the static bowl (src/reflection.ts).
#      Note: the MCP server reads this from its process environment, not this file.
#   2. The founding-dialogue orchestrator (`npm run dialogue`), which reads this file.
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Port for the HTTP entry point (npm start). Defaults to 3000.
# PORT=3000
